{
  "name": "chimango-backend",
  "version": "1.0.0",
  "main": "handler.js",
  "description": "Chimango Tourism Backend - AWS Lambda",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npx serverless offline start",
    "deploy": "npx serverless deploy",
    "dev": "npx serverless offline start --stage dev",
    "build:lambda": "if exist dist rmdir /s /q dist & mkdir dist && xcopy models dist\\models\\ /E /I /Y && xcopy services dist\\services\\ /E /I /Y && copy handler.js dist\\ && copy server.js dist\\ && copy package.json dist\\ && cd dist && npm install --production && cd .."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "serverless": "^3.26.0",
    "serverless-offline": "^12.0.0"
  }
}